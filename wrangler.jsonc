{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "date-quilt",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["17 18 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "date-quilt",
      "database_id": "35bec8a5-2c39-4615-85fe-e9235c3f09d2",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
